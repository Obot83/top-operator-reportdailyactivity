# ─────────────────────────────────────────────
# TOP Operator — Environment Variables
# Salin file ini ke .env dan isi nilainya
# ─────────────────────────────────────────────

# MySQL Connection
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:password@localhost:3306/top_operator"

# Contoh dengan user khusus:
# DATABASE_URL="mysql://top_user:StrongPass123!@localhost:3306/top_operator"

# Next.js
NEXTAUTH_SECRET="ganti-dengan-string-acak-minimal-32-karakter"
NEXTAUTH_URL="http://localhost:3000"

# Storage (S3/R2 untuk foto kunjungan)
STORAGE_ENDPOINT="https://xxxxx.r2.cloudflarestorage.com"
STORAGE_ACCESS_KEY="your-access-key"
STORAGE_SECRET_KEY="your-secret-key"
STORAGE_BUCKET="top-operator-photos"
STORAGE_PUBLIC_URL="https://pub-xxxxx.r2.dev"

# Mobile API URL (diisi IP lokal saat development)
EXPO_PUBLIC_API_URL="http://192.168.1.x:3000"
